/target
node_modules/
dist/
.DS_Store
*.tmp

# Local test photographs are never committed (see tests/fixtures/README.md).
/tests/fixtures/local/*
!/tests/fixtures/local/README.md
!/tests/fixtures/local/manifest.tsv

# Benchmark output
/bench-results/*.json

# Generated by tauri-build on every build
/apps/desktop/src-tauri/gen/

# Written by scripts/third-party-notices.mjs on every dev and build run (ADR 0087)
/apps/desktop/public/third-party-notices.json
